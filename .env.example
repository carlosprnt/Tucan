# Copy to .env and fill with your project values.
# These are EXPO_PUBLIC_* so they are embedded in the client bundle (not secret).

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Google OAuth (from Google Cloud Console -> Credentials)
# iOS client id (type: iOS) and Web client id (type: Web application).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-web.apps.googleusercontent.com
# Reversed iOS client id (the iOS client id with the segments reversed).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123-abc

# Apple sign-in (enable once the Supabase Apple provider is configured).
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false
